# ENS Mobile — build-time configuration (EXPO_PUBLIC_* values are embedded in the app bundle).
# Never put secrets here.

# ENS Core API base (PRD §11), e.g. https://ens.nia.example/api
EXPO_PUBLIC_ENS_API_URL=

# production | uat | development  (non-production shows an environment badge)
EXPO_PUBLIC_ENS_ENVIRONMENT=production

# Comma-separated base64 SHA-256 SPKI pins for the API host (≥ 2 on iOS). Empty disables pinning.
EXPO_PUBLIC_ENS_CERT_PINS=

# Build-time only (app.config.ts): set to 1 once Apple grants the Critical Alerts entitlement.
ENS_IOS_CRITICAL_ALERTS=0
